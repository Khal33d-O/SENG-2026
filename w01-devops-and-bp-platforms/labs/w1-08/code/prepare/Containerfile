# Facilitator preparation of the two W1.08 author images (same eligible base as W1.07):
#   podman build --build-arg RELEASE=a -t localhost/academy-w108-author:a -f Containerfile .
#   podman build --build-arg RELEASE=b -t localhost/academy-w108-author:b -f Containerfile .
# Then import both into the classroom cluster nodes (imagePullPolicy: Never) and record their image IDs in W108_ENV.
