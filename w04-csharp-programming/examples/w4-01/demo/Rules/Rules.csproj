<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared library project: no OutputType, so it builds a .dll that other projects reference.
       It cannot be launched with dotnet run on its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TreasureRules</RootNamespace>
  </PropertyGroup>

</Project>
